<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>JetBrains.ReSharper.Plugins.FSharp.TypeProviders.Host</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="app.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="FSharp.Core">
            <HintPath>..\..\..\..\visualfsharp\artifacts\bin\FSharp.Core\Release\netstandard2.0\FSharp.Core.dll</HintPath>
        </Reference>
        <Reference Include="FSharp.Compiler.Service">
            <HintPath>..\..\..\..\visualfsharp\artifacts\bin\FSharp.Compiler.Service\Debug\netstandard2.0\FSharp.Compiler.Service.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Import Project="$(SolutionDir)/TypeProviders.Host.targets" />
    <Import Project="$(SolutionDir)/GitHubActions.targets" Condition="$(RunningOnGitHubActions) == 'true'" />

    <ItemGroup>
        <Reference Include="FSharp.Core">
            <HintPath>..\..\..\..\visualfsharp\artifacts\bin\FSharp.Core\Release\netstandard2.0\FSharp.Core.dll</HintPath>
        </Reference>
        <Reference Include="FSharp.Compiler.Service">
            <HintPath>..\..\..\..\visualfsharp\artifacts\bin\FSharp.Compiler.Service\Debug\netstandard2.0\FSharp.Compiler.Service.dll</HintPath>
        </Reference>
    </ItemGroup>
</Project>
